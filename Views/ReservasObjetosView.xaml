<Window x:Class="ReservasApp.Views.ReservasObjetosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservas (Objetos)" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Fecha (yyyy-mm-dd):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="dpFecha" Width="150" Margin="0,0,10,0" SelectedDate="{Binding FechaFiltro}"/>
            <Button x:Name="btnBuscar" Content="Buscar" Width="80" Command="{Binding BuscarCommand}"/>
            <Button x:Name="btnVerTodas" Content="Ver todas" Width="90" Margin="10,0,0,0"    Command="{Binding VerTodasCommand}"/>
        </StackPanel>

        <DataGrid x:Name="dgReservas" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" ItemsSource="{Binding Reservas}" />
    </Grid>
</Window>
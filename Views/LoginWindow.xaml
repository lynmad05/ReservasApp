<Window x:Class="ReservasApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión - ReservasApp" Height="480" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== PANEL IZQUIERDO: BRANDING ===== -->
        <Border Grid.Column="0" Background="{StaticResource NavyDark}">
            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="🏫" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="ReservasApp" Foreground="White"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Sistema de gestión de aulas y reservas"
                           Foreground="#8FA5C4" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== PANEL DERECHO: FORMULARIO ===== -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60,0">

            <TextBlock Text="Bienvenido de nuevo" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource NavyPrimary}" Margin="0,0,0,5"/>
            <TextBlock Text="Ingresa tus credenciales para continuar"
                       FontSize="13" Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,30"/>

            <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtUsername" Style="{StaticResource InputTextBox}"
                     Margin="0,0,0,18"/>

            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="txtPassword" Style="{StaticResource InputPasswordBox}"
                         Margin="0,0,0,10"/>

            <TextBlock x:Name="txtMensaje" Foreground="{StaticResource DangerRed}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"
                       Visibility="Collapsed"/>

            <Button x:Name="btnIngresar" Content="Ingresar"
                    Style="{StaticResource PrimaryButton}"
                    Height="42" FontSize="15"
                    Click="btnIngresar_Click"/>

        </StackPanel>
    </Grid>
</Window>
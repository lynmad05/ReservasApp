<UserControl x:Class="ReservasApp.Views.SidebarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="230">

    <Border Background="{StaticResource NavyDark}">
        <DockPanel LastChildFill="True">

            <!-- ===== LOGO / TÍTULO ===== -->
            <StackPanel DockPanel.Dock="Top" Margin="20,25,20,25">
                <TextBlock Text="ReservasApp" Foreground="White"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Gestión de aulas" Foreground="#8FA5C4"
                           FontSize="12" Margin="0,3,0,0"/>
                <Border Height="1" Background="#1E3A63" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- ===== USUARIO + CERRAR SESIÓN (abajo) ===== -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,15">
                <Border Height="1" Background="#1E3A63" Margin="20,0,20,15"/>
                <TextBlock x:Name="txtUsuario" Text="Usuario"
                           Foreground="#C3D1E6" FontSize="12"
                           Margin="20,0,20,10"/>
                <Button x:Name="btnCerrarSesion" Content="Cerrar sesión"
                        Style="{StaticResource SidebarButton}"
                        Foreground="#F6A5A5"
                        Click="btnCerrarSesion_Click"/>
            </StackPanel>

            <!-- ===== OPCIONES DE NAVEGACIÓN ===== -->
            <StackPanel DockPanel.Dock="Top">
                <Button x:Name="btnAulasDataTable" Content="Aulas (DataTable)"
                        Style="{StaticResource SidebarButton}"
                        Click="btnAulasDataTable_Click"/>
                <Button x:Name="btnAulasObjetos" Content="Aulas (Objetos)"
                        Style="{StaticResource SidebarButton}"
                        Click="btnAulasObjetos_Click"/>
                <Button x:Name="btnReservasDataTable" Content="Reservas (DataTable)"
                        Style="{StaticResource SidebarButton}"
                        Click="btnReservasDataTable_Click"/>
                <Button x:Name="btnReservasObjetos" Content="Reservas (Objetos)"
                        Style="{StaticResource SidebarButton}"
                        Click="btnReservasObjetos_Click"/>
                <Button x:Name="btnNuevaReserva" Content="+ Nueva Reserva"
                        Style="{StaticResource SidebarButton}"
                        Click="btnNuevaReserva_Click"/>
            </StackPanel>

        </DockPanel>
    </Border>
</UserControl>
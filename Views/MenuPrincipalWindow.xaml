<Window x:Class="ReservasApp.Views.MenuPrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReservasApp.Views"
        Title="ReservasApp - Menú Principal" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OffWhite}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:SidebarMenu x:Name="Sidebar" Grid.Column="0"
                            NavigationRequested="Sidebar_NavigationRequested"/>

        <ContentControl x:Name="ContentArea" Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="👋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtBienvenida" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource NavyPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Selecciona una opción del menú para comenzar"
                           FontSize="14" Foreground="{StaticResource TextMuted}"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>
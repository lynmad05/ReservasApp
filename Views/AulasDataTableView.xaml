<Window x:Class="ReservasApp.Views.AulasDataTableView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aulas (DataTable)" Height="400" Width="500">
    <Grid Margin="10">
        <DataGrid x:Name="dgAulas" AutoGenerateColumns="True" IsReadOnly="True"
          ItemsSource="{Binding Aulas}"/>
    </Grid>
</Window>